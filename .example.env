NODE_ENV="development"

# Dev - Get a free database from https://neon.com/ and add the credentials here or use your local database using pgadmin
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/dsa-list
DATABASE_URL="postgresql://username:password@host:port/database_name?sslmode=require&channel_binding=require"

# Next-Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="somerandomstring"

# Google OAuth, make sure to add Authorized redirect URIs as http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
